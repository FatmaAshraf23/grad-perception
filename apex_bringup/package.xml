<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apex_bringup</name>
  <version>0.1.0</version>
  <description>Start the REAL car: car settings (checked), RPLIDAR, de-skew, sensor frames, localization</description>
  <maintainer email="fatmaashraf54321@gmail.com">fatma</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>apex_description</exec_depend>
  <exec_depend>lidar_perception</exec_depend>
  <exec_depend>state_estimation</exec_depend>
  <exec_depend>nav2_amcl</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <!-- rplidar_ros (Slamtec, ros2 branch) is built in its own workspace; car.launch.py checks it is sourced -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
