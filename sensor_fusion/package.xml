<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sensor_fusion</name>
  <version>0.1.0</version>
  <description>Camera-LiDAR fusion: projection.py (LiDAR point &lt;-&gt; pixel, lens model, ground plane, cone boxes; numpy only) + projection_demo.</description>
  <maintainer email="fatma@todo.todo">fatma</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>apex_description</exec_depend>

  <test_depend>python3-opencv</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
